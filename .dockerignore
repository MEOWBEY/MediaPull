# Keep the Docker build context small — deploy/docker/Dockerfile builds from
# the repo root so it can see both client/ and server/.

.git
.claude
deploy

client/node_modules
client/.svelte-kit
client/build
client/.env
client/.env.*
!client/.env.example

server/__pycache__
server/app/__pycache__
server/venv
server/.venv
server/.env
server/.env.*
!server/.env.example

**/*.pyc
*.md
