# Normalize line endings; Windows batch files must check out as CRLF.
* text=auto
*.bat text eol=crlf
*.sh text eol=lf

# Binary assets: never run EOL normalization over these — `text=auto` guesses
# per file, and a wrong guess rewrites bytes and corrupts the file.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
