# Root-level ignores for the monorepo.
# Per-package build/dependency ignores live in client/.gitignore and server/.gitignore.

# ── Claude Code / agent local files (personal, machine-specific) ──
.claude/
claude

# ── Environment files (also ignored per-package) ──
.env
.env.*
!.env.example
!.env.test

# ── Server-side default cookies (personal, contains login session data) ──
server/cookies.txt
!server/cookies.example.txt

# ── OS cruft ──
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Editors / IDEs ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs & temp ──
*.log
*.tmp
*.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Python caches (server) ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── Misc personal notes / scratch ──
scratch/
TODO.local.md
notes.local.md
CLAUDE.md
DESIGN-IS-*/

# ── graphify knowledge graph (regenerated on every commit via .git/hooks/post-commit) ──
graphify-out/
