# Root-level ignores for the monorepo.
# Per-package build/dependency ignores live in client/.gitignore and server/.gitignore.

# ── Claude Code / agent local files (personal, machine-specific) ──
.claude/

# ── Environment files (also ignored per-package) ──
.env
.env.*
!.env.example
!.env.test

# ── OS cruft ──
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Editors / IDEs ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs & temp ──
*.log
*.tmp
*.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Python caches (server) ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── Misc personal notes / scratch ──
scratch/
TODO.local.md
notes.local.md
