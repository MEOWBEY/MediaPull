# Backend (Python FastAPI) origin the static client talks to.
#
# Dev: leave this UNSET. Requests stay relative and Vite's dev proxy forwards
# them to the backend (default http://localhost:8000), so there's no CORS.
#
# Production static build: set this to the deployed backend origin, e.g.
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
