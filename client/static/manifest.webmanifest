{
	"name": "MediaPull",
	"short_name": "MediaPull",
	"description": "Paste a URL to get downloadable video formats or an image gallery.",
	"start_url": "/",
	"display": "standalone",
	"background_color": "#141518",
	"theme_color": "#141518",
	"icons": [
		{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
	]
}
