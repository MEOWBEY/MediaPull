# Static file server for the CLIENT ONLY (app.example.com), separate from
# the backend's server block (../../server/vps/nginx-backend.conf.example).
# Install at /etc/nginx/sites-available/directstream-client, then:
#   ln -s /etc/nginx/sites-available/directstream-client /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
# TLS: run certbot afterwards (see README.md).

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    root /opt/directstream/client/build;
    index index.html;

    # SPA fallback: unmatched paths resolve to index.html so client-side
    # routing works on refresh/deep-link.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
