# Static file server for the MediaPull CLIENT (app.example.com), separate from
# the backend's server block (./backend.conf.example). Only needed when you
# serve the client on its own subdomain; the "same-domain" install mode serves
# the built client straight from the FastAPI backend instead (no nginx block).
#
# install.sh fills this in for you. To do it by hand, install at
# /etc/nginx/sites-available/mediapull-client, then:
#   ln -s /etc/nginx/sites-available/mediapull-client /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
# TLS: run certbot afterwards (see README.md).

server {
    listen __PUBLIC_PORT__;
    listen [::]:__PUBLIC_PORT__;
    server_name app.example.com;

    root __REPO_DIR__/client/build;
    index index.html;

    # SPA fallback: unmatched paths resolve to index.html so client-side
    # routing works on refresh/deep-link.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
