[Unit]
Description=DirectStream API (FastAPI backend)
After=network.target

[Service]
Type=simple
User=directstream
Group=directstream
WorkingDirectory=/opt/directstream/server
EnvironmentFile=/opt/directstream/server/.env
# --workers MUST stay 1: JobStore (transcription jobs) and TTLCache (result
# cache) are plain in-process Python dicts, not shared across processes. A
# job created by one gunicorn worker is invisible to another, so >1 worker
# here reproduces "Unknown or expired job" errors on /transcribe polling
# under real traffic. Scale by running more instances behind a load balancer
# (each with its own state) if you need more throughput, not by raising this.
ExecStart=/opt/directstream/server/venv/bin/gunicorn app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:__PORT__ \
    --workers 1 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

# Caps sized at install time from the box's detected CPU/RAM (see install.sh)
# so this service can't peg the VPS and starve nginx/other panels sharing it.
# Re-templated (not just restarted) on every install.sh/update.sh run, so
# edits here get overwritten -- use `systemctl edit directstream` for a
# permanent local override instead.
MemoryMax=__MEMORY_MAX__
CPUQuota=__CPU_QUOTA__

# Light sandboxing — tighten further if you don't need cookie files / a
# cache dir outside the repo.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/directstream

[Install]
WantedBy=multi-user.target
