[Unit]
Description=MediaPull API (FastAPI backend)
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__REPO_DIR__/server
EnvironmentFile=__REPO_DIR__/server/.env
# --workers MUST stay 1: JobStore (transcription jobs), the result TTLCache,
# and the proxy cookie-token map are plain in-process Python state, not shared
# across processes. A job/token created by one gunicorn worker is invisible to
# another, so >1 worker here reproduces "Unknown or expired job" errors on
# /transcribe polling under real traffic. Scale by running more instances
# behind a load balancer (each with its own state), not by raising this.
ExecStart=__REPO_DIR__/server/venv/bin/gunicorn app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:__PORT__ \
    --workers 1 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

# Caps from install-time CPU/RAM detection. Re-templated on update — use
# `systemctl edit mediapull` for permanent local overrides.
MemoryMax=__MEMORY_MAX__
CPUQuota=__CPU_QUOTA__

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__REPO_DIR__

[Install]
WantedBy=multi-user.target
