DEBUG=false
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
WORKERS=1

# Comma-separated allowed client origins, e.g.
#   CORS_ORIGINS=https://app.example.com,https://other.example.com
# The "*" default disables credentialed CORS automatically: browsers reject
# `Access-Control-Allow-Origin: *` together with credentials, so cross-origin
# authenticated requests would fail silently. Pin explicit origins in prod.
CORS_ORIGINS=*

# Single-origin deploy: absolute path to the built static client to serve from
# this same backend (so the SPA uses relative URLs, no CORS). Empty = auto-detect
# ../client/build; leave blank in dev (Vite serves the client).
CLIENT_DIR=

MAX_FORMATS=40
REQUEST_TIMEOUT=90
MAX_RETRIES=2
SCRAPE_MAX_BYTES=200000
EXTRACT_WORKERS=4

# ----- Authentication / anti-block ------------------------------------------
# Server-side DEFAULT cookies, used when a request brings none of its own.
# Netscape cookies.txt path (export with the "Get cookies.txt LOCALLY"
# extension, ideally from an incognito throwaway account). Unlocks
# age-restricted / private / login-gated content and reduces "sign in to
# confirm you're not a bot". Per-user cookies from the UI override this.
# Copy server/cookies.example.txt to server/cookies.txt and paste yours in,
# then point this at it, e.g. COOKIE_FILE_PATHS=./cookies.txt
# SEVERAL accounts: give comma-separated paths (e.g. two Instagram logins) --
#   COOKIE_FILE_PATHS=./cookies-account1.txt,./cookies-account2.txt
# Requests rotate across them; an account that hits a rate limit / bot flag
# rests for 5 minutes while the others keep serving.
COOKIE_FILE_PATHS=
# Cap on the per-request pasted cookie blob (bytes).
MAX_COOKIE_BYTES=262144
# Shared secret enabling POST /admin/cookies -- push freshly-exported cookies to
# the server (the first COOKIE_FILE_PATHS entry) WITHOUT a redeploy. Extraction
# reads the file fresh each request, so the swap is live immediately. Empty =
# endpoint disabled (404). Set a long random value and send it as
# "Authorization: Bearer <token>". Keeps stale VPS cookies fixable in seconds:
#   curl -X POST https://host/admin/cookies -H "Authorization: Bearer $TOKEN" \
#        -H 'Content-Type: application/json' \
#        --data "$(jq -Rs '{cookies:.}' < fresh-cookies.txt)"
ADMIN_TOKEN=

# Outbound proxy for extraction, link probing AND media streaming. Routes
# around datacenter-IP blocks and rate limits. Examples:
#   http://user:pass@host:port      socks5://host:port
PROXY_URL=

# ----- Media proxy security (GET /proxy-video) ------------------------------
# The media proxy fetches user-supplied URLs. It already blocks internal
# targets (loopback / private / link-local / IPv4-mapped IPv6), re-checks the
# host on every redirect hop, and rejects hostnames that resolve to a private
# IP. On a PUBLIC deploy you should still narrow it:
#   PROXY_ENABLED=false        -> disable the proxy entirely (client plays
#                                 sources directly; breaks header-gated sites)
#   PROXY_ALLOWED_HOSTS=...     -> comma-separated destination host allow-list
#                                 (suffix match), e.g.
#     PROXY_ALLOWED_HOSTS=googlevideo.com,cdninstagram.com,fbcdn.net
# Empty allow-list = any public host permitted.
PROXY_ENABLED=true
PROXY_ALLOWED_HOSTS=

# YouTube player clients (comma-separated). Empty = yt-dlp default (full
# quality ladder). Keep "default" in the list so you don't collapse to 360p;
# add age-gate-capable clients, e.g.:  default,tv,web_safari
YOUTUBE_PLAYER_CLIENTS=

# Base URL of the bgutil PO-token provider sidecar. yt-dlp's plugin auto-detects
# http://127.0.0.1:4416, so leave blank UNLESS the provider runs on another port
# (install.sh sets this for you when you pick a non-default port).
YOUTUBE_POT_BASE_URL=

# Random sleep (seconds) between extractor requests. 1–3 markedly cuts
# 429/"used too much" blocks under load. 0 = off.
SLEEP_REQUESTS=0

# Browser impersonation (needs curl_cffi, in requirements) — bypasses anti-bot
# 403/410 on sites like tiktok. Used by both extraction and the media proxy.
ENABLE_IMPERSONATION=true
IMPERSONATE_CLIENT=chrome

# User-Agent sent with extraction/probe/proxy requests. Default (if left
# blank) is a hardcoded Chrome/Windows string in code -- only set this if you
# need something else.
# USER_AGENT=

# Probe extracted links and hide only confirmed-dead ones (404/410/HTML page).
VALIDATE_FORMATS=true
# Per-probe timeout, seconds.
VALIDATE_TIMEOUT=6
# How many format probes run in parallel.
VALIDATE_CONCURRENCY=10
# Cap how many unique format URLs get a live probe (highest res/bitrate first).
# Unprobed formats stay listed (same as an uncertain probe). Each probe is an
# extra outbound request under the timeout/concurrency above.
VALIDATE_MAX_FORMATS=8

# In-memory extraction result cache (video + gallery, separate stores).
# Set either to 0 to disable caching entirely.
CACHE_TTL=300
CACHE_MAX_ENTRIES=512

# ----- Admission control (single-worker public deploys) ---------------------
# Keep WORKERS=1 — JobStore, TTLCache, and cookie tokens are in-process only.
# Concurrent extract runs that actually hit yt-dlp/gallery-dl (cache hits free).
# Overflow → 503 "Server busy" after a short wait so the thread pool can't grow
# without bound under a traffic spike.
EXTRACT_MAX_IN_FLIGHT=8
# Max finished+running transcription jobs kept in RAM (VTT/SRT + dialogue peaks).
# Create returns 503 when full until TRANSCRIBE_JOB_TTL sweeps old ones.
TRANSCRIBE_MAX_JOBS_STORED=64
# Cap on live POST /proxy-token entries (cookie blob → opaque ctok). When full,
# oldest-expiring tokens are evicted so minting never fails hard.
PROXY_COOKIE_TOKEN_MAX=2048

# ----- Auto-generated subtitles (speech-to-text via Groq Whisper) ----------
# Free at https://console.groq.com — no card required. Empty disables the
# /transcribe endpoints (they respond 503 instead of failing mid-pipeline).
# SEVERAL keys may be given, comma-separated:
#   GROQ_API_KEY=gsk_aaa,gsk_bbb,gsk_ccc
# Requests spread across the pool and a rate-limited (429) key is put on
# cooldown while the job instantly retries on the next key — every extra key
# raises how many chunks transcribe in parallel (5 per key, capped at 16).
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Turn the whole /transcribe feature off without touching GROQ_API_KEY.
TRANSCRIBE_ENABLED=true

# Concurrent transcription jobs across ALL clients at once. Each job pins a
# Groq-rate-limited pipeline plus local ffmpeg CPU work, so this is really a
# CPU/RAM knob more than a Groq one — raise it on a beefier box, lower it on
# a small VPS so jobs queue instead of thrashing.
TRANSCRIBE_MAX_CONCURRENT_JOBS=2

# Hard cap (bytes) on the one audio/video stream a job downloads to disk —
# this is the ONLY place in the app that writes media bytes to disk. A video
# whose source file is bigger than this gets rejected rather than filling the
# disk. 300000000 = 300 MB (a ~2-3 hour video at typical bitrates).
TRANSCRIBE_MAX_DOWNLOAD_BYTES=300000000

# Whole-job wall-clock cap (seconds) -- a stuck or abnormally slow job gets
# killed and reported as an error instead of running forever. The default
# (900s/15min) may be tight for very long videos; raise it if you regularly
# transcribe 1hr+ content. Bounded 60-3600.
TRANSCRIBE_JOB_TIMEOUT=900

# How long (seconds) a finished/errored job's result + subtitle files stay
# available for polling/download before being swept from memory. Bump this up
# if users might come back to re-download a .srt well after the job finished.
TRANSCRIBE_JOB_TTL=1800

# Bounds concurrent CPU-heavy pipeline steps (ffmpeg audio transcode +
# dialogue-map peak extraction) separately from TRANSCRIBE_MAX_CONCURRENT_JOBS
# above, which only gates overall job admission -- without this a small VPS
# could end up running several ffmpeg jobs at once even though it's fine to
# have more jobs than that merely waiting on a Groq network round-trip. Match
# to your CPU core count.
TRANSCRIBE_WORKERS=2

# --- Extraction speed (audio for transcription) -----------------------------
# The audio is pulled as several cap-sized time WINDOWS extracted in parallel
# (each its own ffmpeg Range read) instead of one sequential pass, and each
# finished window uploads to Groq while later ones are still downloading. This
# is the big win when "Extracting audio…" is slow but CPU sits idle: it uses
# spare cores AND sidesteps the per-connection throttling many CDNs apply.
#
# How many windows extract at once. Higher = faster on large/throttled sources,
# but more simultaneous connections to the origin -- lower it to 1-2 if a site
# starts returning 429 / "used too much". Applies only to progressive sources
# with a known duration; HLS/unknown-duration fall back to a single pass.
TRANSCRIBE_EXTRACT_PARALLELISM=4
#
# Hard per-file upload cap Groq enforces, in MB (free tier is 25). Windows are
# sized to ~80% of this so a chunk never trips the API's 413. Raise it if your
# Groq plan allows larger uploads.
TRANSCRIBE_MAX_UPLOAD_MB=25
#
# Intermediate audio codec fed to Whisper: opus | wav | flac. In "auto" mode
# (below) this is only the fallback used when the track duration is unknown;
# opus (default) is the safe small choice. opus is tiny; wav is zero-encode-CPU
# but ~8x larger; flac sits between. All are mono/16kHz.
TRANSCRIBE_AUDIO_CODEC=opus
#
# How the audio fed to Whisper is encoded:
#   auto   -- (default) pick the FASTEST encode whose whole track still fits one
#             upload window: wav (no encode CPU) when it fits, else flac, else
#             opus; only compress hard (and chunk) when the track is too long to
#             fit the cap otherwise. Short clips skip the encode; long ones stay
#             under the cap. This is the "decide the fastest way" behaviour.
#   custom -- use TRANSCRIBE_CUSTOM_FFMPEG_ARGS verbatim (you know your source).
TRANSCRIBE_MODE=auto
#
# Custom-mode ffmpeg output args (space-separated), applied after "-i <src>".
# MUST drop video (-vn) and produce a mono Whisper-friendly track. Ignored
# unless TRANSCRIBE_MODE=custom. Empty falls back to the opus preset.
# Example: -vn -ac 1 -ar 16000 -c:a libopus -b:a 24k
TRANSCRIBE_CUSTOM_FFMPEG_ARGS=
# Custom-mode output container extension (match your codec: opus | wav | flac | m4a).
TRANSCRIBE_CUSTOM_EXT=opus
# Custom-mode encoded bytes-per-second estimate, used only to size upload
# windows under the cap. Match your bitrate: bytes/s ≈ kbps * 125
# (32kbps opus ≈ 4000 — the built-in preset; 24kbps ≈ 3000).
TRANSCRIBE_CUSTOM_BYTES_PER_SECOND=4000

# ----- Image/gallery extraction (gallery-dl) --------------------------------
# gallery-dl binary on PATH (or an absolute path). Default "gallery-dl" uses
# `python -m gallery_dl` when the package is installed. Same COOKIE_FILE_PATHS /
# per-request cookies as video extraction (Netscape cookies.txt format).
GALLERY_DL_PATH=gallery-dl
# Wall-clock cap (seconds) for one gallery-dl subprocess run.
GALLERY_DL_TIMEOUT=45
# Concurrent gallery-dl processes (separate from EXTRACT_WORKERS).
GALLERY_DL_WORKERS=3
# Hard cap on images returned per extract. Large albums are truncated (client
# gets a soft "truncated" warning); raise for bulk dumps.
GALLERY_MAX_IMAGES=200

# ----- ffmpeg/ffprobe (transcription pipeline only) -------------------------
# Only used by /transcribe (auto-subtitles + dialogue-map peaks for the seek
# bar). Normal extraction never touches ffmpeg, so a broken install here stays
# invisible until someone generates subtitles. Leave default ("ffmpeg"/
# "ffprobe") to use PATH. If `/health` reports ffmpegAvailable=false, either
# install ffmpeg (`apt install ffmpeg` covers both) or point these at absolute
# paths (e.g. /usr/bin/ffmpeg) — a systemd service PATH can differ from an
# interactive shell's.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
