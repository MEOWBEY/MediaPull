# Production-oriented starting point — copy to server/.env and adjust.
# Every variable here also exists in .env.example with dev-friendly
# defaults; this file just flags what you should actually change before
# going live. See deploy/README.md for the full deployment walkthrough.

DEBUG=false
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
# Keep this at 1. JobStore (transcription jobs) and TTLCache (the result
# cache) are plain in-process Python dicts, not shared across worker
# processes -- a job created by one worker is invisible to another, causing
# "Unknown or expired job" errors when /transcribe's status polling lands on
# a different worker under real traffic. Scale with more instances behind a
# load balancer if you need more throughput, not by raising this.
WORKERS=1

# REQUIRED CHANGE: set this to your deployed client's origin(s), not "*".
# Combined single-process deploy -> same origin as this server, e.g.
#   CORS_ORIGINS=https://your-domain.example
# Split deploy (client on Vercel/Netlify/Cloudflare Pages/etc.) -> that
# origin, e.g.
#   CORS_ORIGINS=https://your-client.vercel.app
CORS_ORIGINS=

# Combined single-process deploy only: path to the built client
# (client/build). Leave empty for a split deploy (backend-only host).
CLIENT_DIR=

MAX_FORMATS=40
REQUEST_TIMEOUT=90
MAX_RETRIES=2
SCRAPE_MAX_BYTES=200000
EXTRACT_WORKERS=4

# ----- Authentication / anti-block ------------------------------------------
# Path to a server-side default Netscape cookies.txt. Copy server/cookies.example.txt
# to server/cookies.txt (gitignored) and paste your real cookies in, or set
# your own path -- keep it permissions 600, owned by the service user.
# Unlocks age-restricted / private / login-gated content when a request
# brings none of its own. install.sh sets this up and points here automatically.
# SEVERAL accounts: comma-separated paths (e.g. two Instagram logins) --
#   COOKIE_FILE=/opt/directstream/server/cookies-a.txt,/opt/directstream/server/cookies-b.txt
# Requests rotate across them; a rate-limited/bot-flagged account rests 5
# minutes while the others keep serving.
COOKIE_FILE=/opt/directstream/server/cookies.txt
# Cap on the per-request pasted cookie blob (bytes).
MAX_COOKIE_BYTES=262144

# Outbound proxy for extraction, link probing AND media streaming — set this
# if your host's IP gets rate-limited/blocked by source sites.
PROXY_URL=

YOUTUBE_PLAYER_CLIENTS=
# Optional manual override -- usually unnecessary, the PO-token provider
# service installed by install.sh handles this automatically.
YOUTUBE_PO_TOKEN=
# Base URL of the bgutil PO-token provider. Blank = auto-detect 127.0.0.1:4416;
# install.sh fills this in when you run the provider on a non-default port.
YOUTUBE_POT_BASE_URL=

# A small delay markedly cuts 429s under real traffic; 0 is fine for
# low-volume personal use.
SLEEP_REQUESTS=0

ENABLE_IMPERSONATION=true
IMPERSONATE_CLIENT=chrome

# User-Agent sent with extraction/probe/proxy requests. Default (if left
# blank) is a hardcoded Chrome/Windows string in code -- only set this if you
# need something else.
# USER_AGENT=

VALIDATE_FORMATS=true
# Per-probe timeout, seconds.
VALIDATE_TIMEOUT=6
# How many format probes run in parallel.
VALIDATE_CONCURRENCY=10

CACHE_TTL=300
CACHE_MAX_ENTRIES=512

# ----- Auto-generated subtitles (speech-to-text via Groq Whisper) ----------
# REQUIRED CHANGE if you want this feature live: get a free key at
# https://console.groq.com — no card required. Leave empty to disable
# /transcribe (it responds 503 instead of failing mid-pipeline).
# ffmpeg must be on PATH; deploy/server/docker already installs it.
# SEVERAL keys may be given, comma-separated (gsk_aaa,gsk_bbb) -- requests
# spread across the pool, a 429'd key cools down while the job instantly
# retries on the next, and chunk parallelism scales 5-per-key (cap 16).
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

TRANSCRIBE_ENABLED=true
# Raise on a beefier box; each concurrent job pins a Groq call + local ffmpeg
# CPU work, so this is mostly a CPU/RAM budget, not a Groq rate-limit knob.
TRANSCRIBE_MAX_CONCURRENT_JOBS=2
# Reject source files bigger than this (bytes) rather than filling disk.
TRANSCRIBE_MAX_DOWNLOAD_BYTES=300000000
# Whole-job wall-clock cap -- kills a stuck/abnormally slow job instead of
# running forever. Raise for regularly-transcribed 1hr+ content. Bounded
# 60-3600.
TRANSCRIBE_JOB_TIMEOUT=900
# How long a finished job's result/.srt stays downloadable before eviction.
TRANSCRIBE_JOB_TTL=1800
# Bounds concurrent ffmpeg transcode/waveform work separately from
# TRANSCRIBE_MAX_CONCURRENT_JOBS (which only gates overall job admission).
# Match to your CPU core count.
TRANSCRIBE_WORKERS=2

# --- Extraction speed (audio for transcription) -----------------------------
# Audio is pulled as several cap-sized time windows extracted in parallel (each
# its own ffmpeg Range read) and uploaded to Groq as each lands. Speeds up a
# network-bound extract (slow "Extracting audio…" while CPU is idle) by using
# spare cores and dodging per-connection CDN throttling.
# Windows extracted at once -- lower to 1-2 if a source starts returning 429.
# Applies to progressive sources with known duration; else a single pass runs.
TRANSCRIBE_EXTRACT_PARALLELISM=4
# Groq's per-file upload cap in MB (free tier 25). Windows target ~80% of it.
TRANSCRIBE_MAX_UPLOAD_MB=25
# Intermediate codec fed to Whisper: opus (default, tiny) | wav (no encode CPU,
# larger) | flac (between). In "auto" mode this is only the unknown-duration
# fallback. All mono/16kHz.
TRANSCRIBE_AUDIO_CODEC=opus
# Encode strategy: auto (default) picks the fastest encode that still fits the
# upload cap (wav->flac->opus), compressing/chunking only when it must; custom
# uses TRANSCRIBE_CUSTOM_FFMPEG_ARGS verbatim.
TRANSCRIBE_MODE=auto
# Custom-mode ffmpeg output args (only used when TRANSCRIBE_MODE=custom). Must
# drop video and yield a mono track, e.g. -vn -ac 1 -ar 16000 -c:a libopus -b:a 24k
TRANSCRIBE_CUSTOM_FFMPEG_ARGS=
TRANSCRIBE_CUSTOM_EXT=opus
TRANSCRIBE_CUSTOM_BYTES_PER_SECOND=4000

# ----- Image/gallery extraction (gallery-dl) --------------------------------
# Requires the `gallery-dl` package (see requirements.txt) and its binary on
# PATH inside the deployed image/host. Reuses COOKIE_FILE / per-request
# cookies above (same Netscape cookies.txt format as video extraction).
GALLERY_DL_BINARY=gallery-dl
GALLERY_DL_TIMEOUT=45
GALLERY_DL_WORKERS=3

# ----- ffmpeg/ffprobe (transcription pipeline only) -------------------------
# Only used by /transcribe and its waveform preview. Check GET /health's
# ffmpegAvailable field after deploying -- if false, either install ffmpeg
# (installs both binaries) or set these to its absolute path.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
