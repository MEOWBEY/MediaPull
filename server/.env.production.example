# Production config — copy to server/.env and adjust.
# All vars also exist in .env.example with dev-friendly defaults.
# This file just flags what to change before going live.

DEBUG=false
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
# Keep at 1. JobStore and TTLCache are in-process dicts, not shared
# across workers. Scale with more instances behind a load balancer.
WORKERS=1

# REQUIRED: set to your client's origin, not "*".
# Same origin (combined deploy): CORS_ORIGINS=https://your-domain.example
# Split deploy (client hosted separately): CORS_ORIGINS=https://your-client.vercel.app
CORS_ORIGINS=

# Combined deploy only: path to the built client (client/build).
# Leave empty for split deploy (backend-only host).
CLIENT_DIR=

MAX_FORMATS=40
REQUEST_TIMEOUT=90
MAX_RETRIES=2
SCRAPE_MAX_BYTES=200000
EXTRACT_WORKERS=4

# ----- Auth / anti-block -------------------------------------------------
# Path to a Netscape cookies.txt for age-restricted/private content.
# Copy server/cookies.example.txt to server/cookies.txt (gitignored)
# and paste your cookies. Keep permissions 600.
# Multiple accounts: comma-separated paths.
#   COOKIE_FILE_PATHS=/opt/mediapull/server/cookies-a.txt,/opt/mediapull/server/cookies-b.txt
# Requests rotate across them; a rate-limited account rests 5 min.
COOKIE_FILE_PATHS=/opt/mediapull/server/cookies.txt
MAX_COOKIE_BYTES=262144
# Enable POST /admin/cookies to refresh the cookie file above without a redeploy
# (YouTube/Instagram exports go stale fast on a VPS). The admin panel session
# also grants this. Empty = disabled (404).
# Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=

# ----- Admin panel (/admin) ------------------------------------------------
# Single admin account. Set BOTH or the panel is disabled (login 404).
# ADMIN_PASSWORD_HASH is a PBKDF2-SHA256 hash, NOT the plaintext password.
# install.sh creates both for you; to roll the password later:
#   python - <<'PY'
#   from app.admin import hash_password
#   print(hash_password("new-password"))
#   PY
# then paste the printed value into server/.env and restart.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Admin session lifetime (minutes).
ADMIN_SESSION_TTL_MIN=720
# Failed logins allowed per IP per 15 minutes before throttling.
ADMIN_LOGIN_RATE_LIMIT=20
# File holding the admin's moderation rules (banned IPs / blocked domains).
ADMIN_STATE_PATH=/opt/mediapull/server/admin-state.json

# Per-IP cap on the quota-burning POST endpoints: requests per 60 seconds.
PAYLOAD_RATE_LIMIT=30

# Outbound proxy if your host IP gets rate-limited/blocked.
PROXY_URL=

# ----- Media proxy security (GET /proxy-video) ---------------------------
# RECOMMENDED on a public box. The proxy fetches user-supplied URLs; it blocks
# internal/private targets and re-checks the host across redirects + resolved
# DNS, but on a public deploy you should also narrow WHERE it can fetch from:
#   PROXY_ALLOWED_HOSTS  comma-separated destination host allow-list (suffix
#                        match), e.g. googlevideo.com,cdninstagram.com,fbcdn.net
# Empty = any public host permitted. For subtitle generation and audio splitting,
# MediaPull automatically selects the lowest-quality video stream with audio to
# minimize bandwidth and processing time.
#                        match). Empty = any public host.
#   PROXY_ENABLED=false  disable the proxy entirely (client plays sources
#                        directly; breaks Referer/Cookie-gated sites).
PROXY_ENABLED=true
PROXY_ALLOWED_HOSTS=

YOUTUBE_PLAYER_CLIENTS=
YOUTUBE_POT_BASE_URL=

# Small delay cuts 429s under real traffic; 0 for personal use.
SLEEP_REQUESTS=0

ENABLE_IMPERSONATION=true
IMPERSONATE_CLIENT=chrome
# USER_AGENT=

VALIDATE_FORMATS=true
VALIDATE_TIMEOUT=6
VALIDATE_CONCURRENCY=10
# Live-probe budget per extract (highest res first); unprobed formats stay listed.
VALIDATE_MAX_FORMATS=8

CACHE_TTL=300
CACHE_MAX_ENTRIES=512

# ----- Admission control (keep WORKERS=1) --------------------------------
# Concurrent extract runs (not cache hits). Overflow → 503 "Server busy".
EXTRACT_MAX_IN_FLIGHT=8
# Cap finished+running transcription jobs in RAM until TRANSCRIBE_JOB_TTL sweep.
TRANSCRIBE_MAX_JOBS_STORED=64
# Cap live POST /proxy-token cookie entries (oldest-expiring evicted when full).
PROXY_COOKIE_TOKEN_MAX=2048

# ----- Auto subtitles (Groq Whisper) -------------------------------------
# Get a free key at https://console.groq.com — no card required.
# Leave empty to disable /transcribe (returns 503).
# Multiple keys: comma-separated (gsk_aaa,gsk_bbb) — requests spread
# across the pool; a 429'd key cools down while the job retries on the next.
# ffmpeg must be on PATH.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

TRANSCRIBE_ENABLED=true
# TRANSCRIBE_WHISPER_PROMPT=...   (anti-hallucination prompt + punctuation;
#                                 empty string sends no prompt)
# TRANSCRIBE_SPLIT_LONG_CUES=true (split long multi-sentence cues; exact with
#                                 word timestamps, times never shift)
# Each concurrent job pins a Groq call + local ffmpeg CPU work.
TRANSCRIBE_MAX_CONCURRENT_JOBS=4
# Whole-job wall-clock cap (60-21600). 7200 covers feature-length content.
TRANSCRIBE_JOB_TIMEOUT=7200
# How long a finished job's result stays downloadable (seconds).
TRANSCRIBE_JOB_TTL=3600
# Concurrent CPU-heavy steps: ffmpeg audio transcode + dialogue-map peaks.
# Match to CPU core count (separate from TRANSCRIBE_MAX_CONCURRENT_JOBS).
TRANSCRIBE_WORKERS=4

# Audio extraction parallelism. Lower to 1-2 if a source returns 429.
# Only applies to progressive sources with known duration.
TRANSCRIBE_EXTRACT_PARALLELISM=6
# Groq per-file upload cap in MB (free tier 25).
TRANSCRIBE_MAX_UPLOAD_MB=25
# Codec: opus (default, tiny) | wav (no encode CPU, larger) | flac (between).
TRANSCRIBE_AUDIO_CODEC=opus
# auto (default) picks fastest encode that fits the upload cap.
# custom uses TRANSCRIBE_CUSTOM_FFMPEG_ARGS verbatim.
TRANSCRIBE_MODE=auto
TRANSCRIBE_CUSTOM_FFMPEG_ARGS=
TRANSCRIBE_CUSTOM_EXT=opus
TRANSCRIBE_CUSTOM_BYTES_PER_SECOND=4000

# ----- Gallery extraction (gallery-dl) -----------------------------------
# Requires gallery-dl on PATH (or python -m gallery_dl). Reuses COOKIE_FILE_PATHS.
GALLERY_DL_PATH=gallery-dl
GALLERY_DL_TIMEOUT=45
GALLERY_DL_WORKERS=3
# Hard cap on images per extract (truncated warning when hit).
GALLERY_MAX_IMAGES=200

# ----- ffmpeg/ffprobe (transcription + split audio) -------------------------
# Used by /transcribe (auto-subtitles + dialogue-map peaks) AND /split-audio.
# Check GET /health's ffmpegAvailable field after deploying.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ----- Local file support ---------------------------------------------------
# Allow users to open local video/audio files directly in the player (no
# upload — the browser creates a blob URL and plays it client-side).
LOCAL_FILES_ENABLED=true

# ----- Split audio (POST /split-audio/*) ------------------------------------
# Split a standalone MP3 off any video URL or local file; the file is kept on
# disk and swept after the TTL window. Requires ffmpeg.
SPLIT_AUDIO_ENABLED=true
# Seconds a split MP3 is kept before deletion (30-3600).
SPLIT_AUDIO_TTL=600

# ----- Shared media size cap (transcribe + split audio) ----------------------
# Cap on every source the server accepts: what a transcription job downloads,
# a local transcript upload, and what the audio splitter takes. Oversized
# sources are rejected before any bytes are written. The /health endpoint
# exposes this exact value so the client can pre-reject oversized files.
# Legacy TRANSCRIBE_MAX_DOWNLOAD_BYTES / SPLIT_AUDIO_MAX_BYTES still work;
# MEDIA_MAX_SOURCE_BYTES wins when both are set.
MEDIA_MAX_SOURCE_BYTES=500000000
# IMPORTANT — reverse-proxy upload limit must match or exceed this value.
# nginx:  add `client_max_body_size 500m;` in your server{} block
# Caddy:  no change needed (no built-in body-size limit)
# Apache: add `LimitRequestBody 524288000` in the VirtualHost block
