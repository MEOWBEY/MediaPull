# Production config — copy to server/.env and adjust.
# All vars also exist in .env.example with dev-friendly defaults.
# This file just flags what to change before going live.

DEBUG=false
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
# Keep at 1. JobStore and TTLCache are in-process dicts, not shared
# across workers. Scale with more instances behind a load balancer.
WORKERS=1

# REQUIRED: set to your client's origin, not "*".
# Same origin (combined deploy): CORS_ORIGINS=https://your-domain.example
# Split deploy (client hosted separately): CORS_ORIGINS=https://your-client.vercel.app
CORS_ORIGINS=

# Combined deploy only: path to the built client (client/build).
# Leave empty for split deploy (backend-only host).
CLIENT_DIR=

MAX_FORMATS=40
REQUEST_TIMEOUT=90
MAX_RETRIES=2
SCRAPE_MAX_BYTES=200000
EXTRACT_WORKERS=4

# ----- Auth / anti-block -------------------------------------------------
# Path to a Netscape cookies.txt for age-restricted/private content.
# Copy server/cookies.example.txt to server/cookies.txt (gitignored)
# and paste your cookies. Keep permissions 600.
# Multiple accounts: comma-separated paths.
#   COOKIE_FILE=/opt/pullbox/server/cookies-a.txt,/opt/pullbox/server/cookies-b.txt
# Requests rotate across them; a rate-limited account rests 5 min.
COOKIE_FILE=/opt/pullbox/server/cookies.txt
MAX_COOKIE_BYTES=262144

# Outbound proxy if your host IP gets rate-limited/blocked.
PROXY_URL=

# ----- Media proxy security (GET /proxy-video) ---------------------------
# RECOMMENDED on a public box. The proxy fetches user-supplied URLs; it blocks
# internal/private targets and re-checks the host across redirects + resolved
# DNS, but on a public deploy you should also narrow WHERE it can fetch from:
#   PROXY_ALLOWED_HOSTS  comma-separated destination host allow-list (suffix
#                        match). Empty = any public host.
#   PROXY_ENABLED=false  disable the proxy entirely (client plays sources
#                        directly; breaks Referer/Cookie-gated sites).
PROXY_ENABLED=true
PROXY_ALLOWED_HOSTS=googlevideo.com,cdninstagram.com,fbcdn.net,twimg.com

YOUTUBE_PLAYER_CLIENTS=
YOUTUBE_PO_TOKEN=
YOUTUBE_POT_BASE_URL=

# Small delay cuts 429s under real traffic; 0 for personal use.
SLEEP_REQUESTS=0

ENABLE_IMPERSONATION=true
IMPERSONATE_CLIENT=chrome
# USER_AGENT=

VALIDATE_FORMATS=true
VALIDATE_TIMEOUT=6
VALIDATE_CONCURRENCY=10

CACHE_TTL=300
CACHE_MAX_ENTRIES=512

# ----- Auto subtitles (Groq Whisper) -------------------------------------
# Get a free key at https://console.groq.com — no card required.
# Leave empty to disable /transcribe (returns 503).
# Multiple keys: comma-separated (gsk_aaa,gsk_bbb) — requests spread
# across the pool; a 429'd key cools down while the job retries on the next.
# ffmpeg must be on PATH.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

TRANSCRIBE_ENABLED=true
# Each concurrent job pins a Groq call + local ffmpeg CPU work.
TRANSCRIBE_MAX_CONCURRENT_JOBS=2
TRANSCRIBE_MAX_DOWNLOAD_BYTES=300000000
# Whole-job wall-clock cap (60-3600). Raise for 1hr+ content.
TRANSCRIBE_JOB_TIMEOUT=900
# How long a finished job's result stays downloadable (seconds).
TRANSCRIBE_JOB_TTL=1800
# Concurrent ffmpeg transcode/waveform workers. Match to CPU core count.
TRANSCRIBE_WORKERS=2

# Audio extraction parallelism. Lower to 1-2 if a source returns 429.
# Only applies to progressive sources with known duration.
TRANSCRIBE_EXTRACT_PARALLELISM=4
# Groq per-file upload cap in MB (free tier 25).
TRANSCRIBE_MAX_UPLOAD_MB=25
# Codec: opus (default, tiny) | wav (no encode CPU, larger) | flac (between).
TRANSCRIBE_AUDIO_CODEC=opus
# auto (default) picks fastest encode that fits the upload cap.
# custom uses TRANSCRIBE_CUSTOM_FFMPEG_ARGS verbatim.
TRANSCRIBE_MODE=auto
TRANSCRIBE_CUSTOM_FFMPEG_ARGS=
TRANSCRIBE_CUSTOM_EXT=opus
TRANSCRIBE_CUSTOM_BYTES_PER_SECOND=4000

# ----- Gallery extraction (gallery-dl) -----------------------------------
# Requires gallery-dl on PATH. Reuses COOKIE_FILE above.
GALLERY_DL_BINARY=gallery-dl
GALLERY_DL_TIMEOUT=45
GALLERY_DL_WORKERS=3

# ----- ffmpeg/ffprobe (transcription only) -------------------------------
# Check GET /health's ffmpegAvailable field after deploying.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe